# Copy to .env.local and fill in. Never commit real values.
# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; bypasses row security. Never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: the site address used in password-reset links
# (http://localhost:3000 locally, the real domain in production).
NEXT_PUBLIC_SITE_URL=
