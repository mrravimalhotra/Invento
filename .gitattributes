# Line endings: the repository always stores LF, whatever the machine (Windows, Linux).
# Without this, a Windows checkout with core.autocrlf can turn whole files into
# "changed" lines and make patches (git am) fail or look enormous.
* text=auto eol=lf

# Shell scripts must keep LF line endings (they run on Linux).
*.sh text eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.docx binary
*.woff binary
*.woff2 binary
